{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "propositum_formarum",
  "version": "1.0.0",
  "identifier": "com.acreanosama.propositum-formarum",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Propositum Formarum",
        "url": "index.html",
        "center": true,        
        "width": 1280,
        "height": 720,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "Carregando...",
        "url": "/splashscreen.html",
        "center": true,        
        "resizable": false,
        "decorations": false,  
        "transparent": true,   
        "alwaysOnTop": true,
        "width": 1280,
        "height": 720    
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {}
  }
}
