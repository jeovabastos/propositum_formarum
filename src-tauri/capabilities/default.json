{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "splashscreen"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "core:image:default",
    "core:window:default",
    "core:menu:default",
    "dialog:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-home-write",
    "fs:allow-home-read",
    "fs:write-files",
    "core:path:default",
    "fs:allow-app-write",
    "fs:allow-app-read",
    "fs:write-all",
    {
      "identifier": "fs:allow-write-file", 
      "allow": [{ "path": "$HOME/**" }]
    },
    "fs:allow-read-file"
  ]
}
